{
  "id": "tabs",
  "name": "Tabs",
  "summary": "Open, close, reopen, switch, pin, duplicate and move tabs in the tree (Arc + Horse shortcuts).",
  "entry": "TabsFeature",
  "provides": [
    "tabs.commands"
  ],
  "commands": [
    {
      "id": "tabs.new-window",
