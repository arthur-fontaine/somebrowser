{
  "id": "archive",
  "name": "Archive",
  "summary": "Today tabs you haven't looked at for a while archive themselves (Arc); find them again in the archive.",
  "entry": "ArchiveFeature",
  "provides": ["archive"],
  "commands": [
    { "id": "archive.show", "title": "Show Archive", "shortcut": "cmd+opt+a", "menu": "History", "group": "panel", "order": 2, "keywords": ["archived tabs"] },
    { "id": "archive.run-now", "title": "Archive Idle Tabs Now", "menu": "Tabs", "group": "clear", "order": 3 }
  ],
  "settings": [
    { "key": "archive.after", "title": "Archive Today tabs after", "type": "choice", "default": "12h", "options": ["1h", "6h", "12h", "24h", "7d", "never"] },
    { "key": "archive.keepDays", "title": "Keep archived tabs for (days)", "type": "int", "default": 30 }
  ]
}
