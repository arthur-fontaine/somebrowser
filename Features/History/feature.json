{
  "id": "history",
  "name": "History",
  "summary": "Local browsing history (SQLite) with a searchable panel and command-bar results ranked by frecency.",
  "entry": "HistoryFeature",
  "provides": ["history"],
  "frameworks": [],
  "commands": [
    { "id": "history.show", "title": "Show History", "shortcut": "cmd+y", "alternateShortcuts": ["cmd+shift+h"], "menu": "History", "group": "panel", "order": 1 },
