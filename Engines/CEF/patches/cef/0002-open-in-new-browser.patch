+BrowserWindowInterface* ChromeBrowserDelegate::OpenInNewBrowser(
+    content::WebContents* source_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    bool user_gesture,
+    std::unique_ptr<content::WebContents>& new_contents) {
+  DCHECK(new_contents);
+  auto opener = ChromeBrowserHostImpl::GetBrowserForContents(source_contents);
+  if (!opener || !opener->is_views_hosted()) {
+    return nullptr;
+  }
+
+  // The steps of a renderer-created popup, with the source page's main frame
+  // as the opener.
+  content::RenderFrameHost* opener_frame =
+      source_contents->GetPrimaryMainFrame();
+
+  // 1. CefLifeSpanHandler::OnBeforePopup.
+  bool no_javascript_access = false;
+  if (!CefBrowserInfoManager::GetInstance()->CanCreateWindow(
+          opener_frame, target_url, content::Referrer(),
+          /*frame_name=*/std::string(), disposition,
+          blink::mojom::WindowFeatures(), user_gesture,
+          /*opener_suppressed=*/true, &no_javascript_access)) {
+    return nullptr;
+  }
+
+  // CanCreateWindow files the pending popup under the URL as filtered for the
+  // opener's process.
+  GURL popup_url = target_url;
+  opener_frame->GetProcess()->FilterURL(/*empty_allowed=*/false, &popup_url);
+
+  // 2. The browser host and its Views BrowserView
+  // (CefBrowserViewDelegate::OnPopupBrowserViewCreated). SessionTabHelper must
+  // exist before CEF initializes the popup browser host.
+  content::WebContents* contents = new_contents.get();
+  CreateSessionServiceTabHelper(contents);
+  OnPopupWebContentsCreated(source_contents, opener_frame->GetGlobalId(),
+                            /*frame_name=*/std::string(), popup_url, contents);
+
+  // 3. The new Browser, which takes the WebContents.
+  new_contents = AddWebContents(std::move(new_contents));
+  if (new_contents) {
+    // Not hosted (default popup creation): it already has a browser host.
+    new_contents.reset();
+    return nullptr;
+  }
+  auto browser_host = ChromeBrowserHostImpl::GetBrowserForContents(contents);
+  return browser_host ? browser_host->browser() : nullptr;
+}
