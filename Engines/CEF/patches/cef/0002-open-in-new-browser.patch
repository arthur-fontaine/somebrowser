       const GURL& target_url,
       content::WebContents* new_contents) = 0;
 
+  // Open |target_url| in a new Views-hosted browser instead of a new tab of a
+  // default Browser, the way a renderer-created popup of |source_contents|
+  // opens (CefLifeSpanHandler::OnBeforePopup, then
+  // CefBrowserViewDelegate::OnPopupBrowserViewCreated). On success takes
+  // |new_contents| (not navigated yet) and returns its new Browser. Returns
+  // nullptr and leaves |new_contents| untouched if declined before anything was
+  // made of it (e.g. the client cancels the popup): the caller may open it the
+  // default way. Returns nullptr and destroys it if hosting failed later.
+  virtual BrowserWindowInterface* OpenInNewBrowser(
+      content::WebContents* source_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      bool user_gesture,
+      std::unique_ptr<content::WebContents>& new_contents) {
+    return nullptr;
+  }
