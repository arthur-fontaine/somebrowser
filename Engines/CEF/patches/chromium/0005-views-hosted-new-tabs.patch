+#if BUILDFLAG(ENABLE_CEF)
+// With --views-hosted-new-tabs, a new tab or window for a page an embedder
+// hosts in its own views, one page per browser (CEF), opens as a new browser
+// of the embedder's, the way the page's popups do, instead of a tab of a stock
+// window: the tab keeps its WebContents, so extensions' tab ids last.
+bool OpensInNewViewsHostedBrowser(const NavigateParams& params) {
+  BrowserWindowInterface* const browser = params.browser;
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_POPUP ||
+      !browser->cef_delegate() || !browser->cef_delegate()->IsViewsHosted() ||
+      !params.source_contents || params.contents_to_insert ||
+      params.switch_to_singleton_tab || WindowCanOpenTabs(params)) {
+    return false;
+  }
+  if (params.disposition != WindowOpenDisposition::NEW_FOREGROUND_TAB &&
+      params.disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB &&
+      params.disposition != WindowOpenDisposition::NEW_WINDOW) {
+    return false;
+  }
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "views-hosted-new-tabs");
+}
+
+base::WeakPtr<content::NavigationHandle> OpenInNewViewsHostedBrowser(
+    NavigateParams* params) {
+  Profile* const profile = params->browser->GetProfile();
+  WebContents::CreateParams create_params(
+      profile, tab_util::GetSiteInstanceForNewTab(profile, params->url));
+  create_params.initially_hidden =
+      params->disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  std::unique_ptr<WebContents> new_contents =
+      WebContents::Create(create_params);
+  WebContents* const contents = new_contents.get();
+  BrowserWindowInterface* const browser =
+      params->browser->cef_delegate()->OpenInNewBrowser(
+          params->source_contents, params->url, params->disposition,
+          params->user_gesture, new_contents);
+  if (!browser) {
+    // The embedder cancelled it, as it may cancel a popup.
+    return nullptr;
+  }
+  params->browser = browser;
+  params->navigated_or_inserted_contents = contents;
+  if (HandleNonNavigationAboutURL(params->url, contents->GetBrowserContext())) {
+    return nullptr;
+  }
+  return contents->GetController().LoadURLWithParams(
+      LoadURLParamsFromNavigateParams(contents, params));
+}
