 gfx::Rect ScrollbarThemeMac::TrackRect(const Scrollbar& scrollbar) const {
-  return scrollbar.FrameRect();
+  gfx::Rect rect = scrollbar.FrameRect();
+  // The page's own scroller: the outermost main frame's layout view.
+  const LayoutBox* box = scrollbar.GetLayoutBox();
+  if (!box || !box->IsLayoutView() || !box->GetFrame() ||
+      !box->GetFrame()->IsOutermostMainFrame() ||
+      !base::FeatureList::IsEnabled(kRootScrollbarAvoidsCorners)) {
+    return rect;
+  }
+  const int inset = kRootScrollbarCornerInset.Get() * scrollbar.ScaleFromDIP();
+  if (scrollbar.Orientation() == kVerticalScrollbar) {
+    rect.Inset(gfx::Insets::TLBR(inset, 0, inset, 0));
+  } else {
+    rect.Inset(gfx::Insets::TLBR(0, inset, 0, inset));
+  }
+  return rect;
 }
 
