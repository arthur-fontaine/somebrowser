 namespace blink {
 
+namespace {
+
+// For embedders that round the page's corners: the page's own (root)
+// scrollbars keep their thumbs clear of them, the thumb's travel inset by
+// `inset` DIPs at both ends of the (full-length, corner-clipped) track.
+// --enable-features=RootScrollbarAvoidsCorners:inset/4
+BASE_FEATURE(kRootScrollbarAvoidsCorners, base::FEATURE_DISABLED_BY_DEFAULT);
+const base::FeatureParam<int> kRootScrollbarCornerInset{
+    &kRootScrollbarAvoidsCorners, "inset", 4};
+
+// The thumb's travel: the track, inset at both ends for the page's own (root)
+// scroller when kRootScrollbarAvoidsCorners is on (0 otherwise).
+int RootScrollbarCornerInset(const Scrollbar& scrollbar) {
+  const LayoutBox* box = scrollbar.GetLayoutBox();
+  if (!box || !box->IsLayoutView() || !box->GetFrame() ||
+      !box->GetFrame()->IsOutermostMainFrame() ||
+      !base::FeatureList::IsEnabled(kRootScrollbarAvoidsCorners)) {
+    return 0;
+  }
+  return kRootScrollbarCornerInset.Get() * scrollbar.ScaleFromDIP();
+}
+
